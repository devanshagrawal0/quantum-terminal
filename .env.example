# ============================================================
#  PUBLIC WALLET ADDRESSES AND READ-ONLY TOKENS ONLY.
#  NEVER put a private key, seed phrase or trading API key here.
#  Nothing in this repository can sign, place, cancel or withdraw.
# ============================================================

# Hyperliquid - your public 0x address (read-only account view)
HL_ACCOUNT_ADDRESS=0x

# Lighter - the L1 address you use there (often the same wallet)
LIGHTER_L1_ADDRESS=0x

# Lighter read-only token (https://app.lighter.xyz/read-only-tokens/)
# Looks like ro:<account>:all:<expiry>:<hex>. It cannot trade or withdraw.
LIGHTER_READONLY_TOKEN=

# Optional: contact address sent in the User-Agent to public data APIs that ask for one (e.g. SEC)
CONTACT_EMAIL=
